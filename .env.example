# Docker Registry Credentials
# Copy this file to .env and fill in your credentials
# .env will be sourced by start-jupyter.sh to authenticate with the Docker registry

# Example:

VRE_REGISTRY_USERNAME=
VRE_REGISTRY_PASSWORD=
VRE_REGISTRY_URL=registry.gitlab.eox.at

# VRE container image tag — used by extract-vre-environment.sh,
# register-vre-kernel.sh, and start-vre.sh
VRE_TAG=1.0.11

# Anthropic API Key for Jupyter AI
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
